"""Страница редактора песен для PyQt6."""

import os
import sys
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.dirname(__file__))))

from PyQt6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QLineEdit, QPushButton, QTextEdit,
    QProgressBar, QScrollArea, QFrame,
    QMessageBox, QFileDialog, QDialog, QInputDialog,
    QListWidget, QListWidgetItem, QComboBox,
    QTabWidget, QTabBar,
)
from PyQt6.QtCore import Qt, pyqtSignal, QTimer
from PyQt6.QtGui import QFont

from engine import editor
from engine import structure
from engine import rhymes
from engine import history
from engine import rhyme_analyzer
from utils import export
from engine import phrases as phrases_engine


class SectionWidget(QFrame):
    def __init__(self, sec_key, sec_data, parent=None):
        super().__init__(parent)
        self.sec_key = sec_key
        self.sec_data = sec_data.copy()
        self._current_text = ''
        self.setObjectName('card_frame')
        self._init_ui()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(15, 12, 15, 10)
        layout.setSpacing(6)

        icon = self._get_icon(self.sec_data['type'])
        header = QHBoxLayout()
        lbl = QLabel(icon + ' ' + self.sec_data['label'])
        lbl.setFont(QFont('Segoe UI', 12, QFont.Weight.Bold))
        lbl.setStyleSheet('color: #ffffff;')
        header.addWidget(lbl)

        type_lbl = QLabel(self.sec_data['type'].capitalize())
        type_lbl.setObjectName('subheading_label')
        header.addWidget(type_lbl)
        hint = self.sec_data.get('lines_hint', 0)
        if hint > 0:
            hint_lbl = QLabel('~' + str(hint) + ' строк')
            hint_lbl.setObjectName('subheading_label')
            header.addWidget(hint_lbl)
        header.addStretch()
        layout.addLayout(header)

        self.text_area = QTextEdit()
        self.text_area.setPlaceholderText('Введите текст...')
        self.text_area.setMinimumHeight(130)
        layout.addWidget(self.text_area)

        p_layout = QHBoxLayout()
        self.lines_lbl = QLabel('Строк: 0')
        p_layout.addWidget(self.lines_lbl)
        self.sec_progress = QProgressBar()
        if hint > 0:
            self.sec_progress.setMaximum(hint)
            self.sec_progress.setValue(0)
        else:
            self.sec_progress.hide()
        p_layout.addWidget(self.sec_progress, 1)
        layout.addLayout(p_layout)

        tips = self.sec_data.get('tips', [])
        if tips:
            tips_frame = QFrame()
            tips_frame.setStyleSheet('background-color: #1f2b4d; border-radius: 8px; padding: 8px;')
            tips_layout = QVBoxLayout(tips_frame)
            tips_title = QLabel('Советы:')
            tips_title.setFont(QFont('Segoe UI', 9, QFont.Weight.Bold))
            tips_layout.addWidget(tips_title)
            for tip in tips[:3]:
                t = QLabel('• ' + tip)
                t.setObjectName('subheading_label')
                t.setWordWrap(True)
                tips_layout.addWidget(t)
            layout.addWidget(tips_frame)

    def _get_icon(self, sec_type):
        icons = {'куплет': 'C', 'припев': 'C', 'бридж': 'C'}
        return icons.get(sec_type, '?')

    def _on_text_changed(self):
        pass

    def get_text(self):
        return self.text_area.toPlainText()

    def set_text(self, text):
        self._current_text = text
        # Не вызываем setPlainText чтобы не триггерить сигнал
        self.text_area.setPlainText(text)

    def update_line_count(self, count):
        self.lines_lbl.setText('Строк: ' + str(count))
        if self.sec_progress.isVisible():
            self.sec_progress.setValue(min(count, self.sec_progress.maximum()))


class AIRecommendationsPanel(QFrame):
    """Панель AI-рекомендаций по улучшению текста песни."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedWidth(320)
        self._init_ui()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 10, 12, 10)
        layout.setSpacing(8)

        # Заголовок
        title = QLabel('🤖 AI-рекомендации')
        title.setFont(QFont('Segoe UI', 13, QFont.Weight.Bold))
        title.setStyleSheet('color: #ffffff;')
        layout.addWidget(title)

        # Индикатор качества
        self.quality_label = QLabel('Начните писать текст')
        self.quality_label.setFont(QFont('Segoe UI', 11))
        self.quality_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.quality_label.setStyleSheet('color: #888; padding: 10px;')
        layout.addWidget(self.quality_label)

        # Прогресс рифмовки
        rhyme_frame = QFrame()
        rhyme_frame.setStyleSheet('background-color: #16213e; border-radius: 8px; padding: 8px;')
        rhyme_layout = QVBoxLayout(rhyme_frame)
        rhyme_title = QLabel('🎵 Рифмовка')
        rhyme_title.setFont(QFont('Segoe UI', 10, QFont.Weight.Bold))
        rhyme_title.setStyleSheet('color: #00bcd4;')
        rhyme_layout.addWidget(rhyme_title)
        self.rhyme_progress = QProgressBar()
        self.rhyme_progress.setFixedHeight(12)
        rhyme_layout.addWidget(self.rhyme_progress)
        self.rhyme_text = QLabel('0% рифмовано')
        self.rhyme_text.setObjectName('subheading_label')
        rhyme_layout.addWidget(self.rhyme_text)
        layout.addWidget(rhyme_frame)

        # Прогресс ритма
        rhythm_frame = QFrame()
        rhythm_frame.setStyleSheet('background-color: #16213e; border-radius: 8px; padding: 8px;')
        rhythm_layout = QVBoxLayout(rhythm_frame)
        rhythm_title = QLabel('🥁 Ритм')
        rhythm_title.setFont(QFont('Segoe UI', 10, QFont.Weight.Bold))
        rhythm_title.setStyleSheet('color: #4CAF50;')
        rhythm_layout.addWidget(rhythm_title)
        self.rhythm_progress = QProgressBar()
        self.rhythm_progress.setFixedHeight(12)
        rhythm_layout.addWidget(self.rhythm_progress)
        self.rhythm_text = QLabel('Слогов: 0')
        self.rhythm_text.setObjectName('subheading_label')
        rhythm_layout.addWidget(self.rhythm_text)
        layout.addWidget(rhythm_frame)

        # Блок с рифмами к последнему слову
        self.rhymes_block = QFrame()
        self.rhymes_block.setStyleSheet('background-color: #16213e; border-radius: 8px; padding: 8px;')
        rhymes_layout = QVBoxLayout(self.rhymes_block)
        rhymes_title = QLabel('🔤 Рифмы')
        rhymes_title.setFont(QFont('Segoe UI', 10, QFont.Weight.Bold))
        rhymes_title.setStyleSheet('color: #e94560;')
        rhymes_layout.addWidget(rhymes_title)
        self.rhymes_scroll = QScrollArea()
        self.rhymes_scroll.setWidgetResizable(True)
        self.rhymes_scroll.setFixedHeight(120)
        self.rhymes_scroll.setFrameShape(QFrame.Shape.NoFrame)
        rhymes_content = QWidget()
        self.rhymes_content_layout = QVBoxLayout(rhymes_content)
        self.rhymes_content_layout.setSpacing(4)
        self.rhymes_content_layout.setContentsMargins(4, 4, 4, 4)
        self.rhymes_scroll.setWidget(rhymes_content)
        rhymes_layout.addWidget(self.rhymes_scroll)
        layout.addWidget(self.rhymes_block)

        # Блок со случайными фразами
        self.phrases_block = QFrame()
        self.phrases_block.setStyleSheet('background-color: #16213e; border-radius: 8px; padding: 8px;')
        phrases_layout = QVBoxLayout(self.phrases_block)
        phrases_title = QLabel('💬 Вдохновение')
        phrases_title.setFont(QFont('Segoe UI', 10, QFont.Weight.Bold))
        phrases_title.setStyleSheet('color: #ff9800;')
        phrases_layout.addWidget(phrases_title)
        self.phrases_scroll = QScrollArea()
        self.phrases_scroll.setWidgetResizable(True)
        self.phrases_scroll.setFixedHeight(120)
        self.phrases_scroll.setFrameShape(QFrame.Shape.NoFrame)
        phrases_content = QWidget()
        self.phrases_content_layout = QVBoxLayout(phrases_content)
        self.phrases_content_layout.setSpacing(4)
        self.phrases_content_layout.setContentsMargins(4, 4, 4, 4)
        self.phrases_scroll.setWidget(phrases_content)
        phrases_layout.addWidget(self.phrases_scroll)
        layout.addWidget(self.phrases_block)

        # Область рекомендаций
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.Shape.NoFrame)
        content = QWidget()
        self.recs_layout = QVBoxLayout(content)
        self.recs_layout.setSpacing(6)
        self.recs_layout.setContentsMargins(5, 5, 5, 5)
        self.scroll.setWidget(content)
        layout.addWidget(self.scroll, 1)

        # Кнопка обновить
        refresh_btn = QPushButton('🔄 Обновить анализ')
        refresh_btn.setMinimumHeight(32)
        refresh_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        refresh_btn.clicked.connect(lambda: self.analyze_from_context(self._parent_editor.template_context) if hasattr(self, '_parent_editor') else None)
        layout.addWidget(refresh_btn)

    def set_song_data(self, song_data):
        """Установить данные песни для анализа."""
        self.current_song_data = song_data

    def analyze_from_context(self, template_context):
        """Анализировать текст из template_context (текущий ввод)."""
        if not template_context:
            return

        # Собираем все строки из template_context (текущий ввод)
        all_lines = []
        sections = template_context.get('sections', {})
        for sec_key, sec_data in sections.items():
            text = sec_data.get('text', '')
            if text.strip():
                lines = [l.strip() for l in text.split('\n') if l.strip()]
                all_lines.extend(lines)

        if not all_lines:
            self.quality_label.setText('Начните писать текст')
            self.quality_label.setStyleSheet('color: #888; padding: 10px;')
            self.rhyme_progress.setValue(0)
            self.rhyme_text.setText('0% рифмовано')
            self.rhythm_progress.setValue(0)
            self.rhythm_text.setText('Слогов: 0')
            self._clear_recommendations()
            return

        # Анализируем
        analysis = rhyme_analyzer.analyze_rhyme_scheme(all_lines)
        rhythm = rhyme_analyzer.analyze_rhythm(all_lines)
        words = rhyme_analyzer.analyze_words(all_lines)
        recs = rhyme_analyzer.get_recommendations(analysis, rhythm, words)

        # Обновляем индикаторы
        quality_score = int(analysis['stats']['percent'])
        self.rhyme_progress.setValue(quality_score)
        self.rhyme_text.setText(str(quality_score) + '% рифмовано')

        # Цвет прогресса рифмовки
        if quality_score >= 70:
            self.rhyme_progress.setStyleSheet('QProgressBar::chunk { background-color: #4CAF50; }')
            self.quality_label.setText('✨ Отлично!')
            self.quality_label.setStyleSheet('color: #4CAF50; padding: 10px; font-weight: bold;')
        elif quality_score >= 50:
            self.rhyme_progress.setStyleSheet('QProgressBar::chunk { background-color: #ff9800; }')
            self.quality_label.setText('💡 Можно лучше')
            self.quality_label.setStyleSheet('color: #ff9800; padding: 10px; font-weight: bold;')
        else:
            self.rhyme_progress.setStyleSheet('QProgressBar::chunk { background-color: #f44336; }')
            self.quality_label.setText('⚠️ Нужно доработать')
            self.quality_label.setStyleSheet('color: #f44336; padding: 10px; font-weight: bold;')

        # Обновляем ритм
        avg_syllables = rhythm.get('average', 0)
        consistency = rhythm.get('consistency', 0)
        self.rhythm_progress.setValue(int(consistency))
        self.rhythm_text.setText('Среднее: ' + str(avg_syllables) + ' слогов')

        if consistency >= 80:
            self.rhythm_progress.setStyleSheet('QProgressBar::chunk { background-color: #4CAF50; }')
        elif consistency >= 60:
            self.rhythm_progress.setStyleSheet('QProgressBar::chunk { background-color: #ff9800; }')
        else:
            self.rhythm_progress.setStyleSheet('QProgressBar::chunk { background-color: #f44336; }')

        # Показываем рифмы к последнему слову
        self._show_last_word_rhymes(all_lines)

        # Показываем случайные фразы
        self._show_random_phrases()

        # Показываем рекомендации
        self._show_recommendations(recs, words, analysis)

    def _show_last_word_rhymes(self, all_lines):
        """Показать рифмы к последнему слову последней строки."""
        self._clear_layout(self.rhymes_content_layout)

        if not all_lines:
            lbl = QLabel('Печатайте текст...')
            lbl.setObjectName('subheading_label')
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.rhymes_content_layout.addWidget(lbl)
            return

        # Берём последнюю непустую строку
        last_line = ''
        for line in reversed(all_lines):
            if line.strip():
                last_line = line.strip()
                break

        if not last_line:
            lbl = QLabel('Печатайте текст...')
            lbl.setObjectName('subheading_label')
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.rhymes_content_layout.addWidget(lbl)
            return

        # Извлекаем последнее слово
        words = last_line.lower().split()
        last_word = words[-1].strip('.,!?;:\"\'[]}{()') if words else ''

        if not last_word or len(last_word) < 3:
            lbl = QLabel('Слишком короткое слово')
            lbl.setObjectName('subheading_label')
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.rhymes_content_layout.addWidget(lbl)
            return

        # Ищем рифмы
        suggested = rhymes.get_rhymes(last_word, max_results=6)

        if not suggested:
            lbl = QLabel('Рифмы не найдены')
            lbl.setObjectName('subheading_label')
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.rhymes_content_layout.addWidget(lbl)
            return

        for rhyme in suggested:
            rhyme_btn = QPushButton(rhyme)
            rhyme_btn.setCursor(Qt.CursorShape.PointingHandCursor)
            rhyme_btn.setStyleSheet("""
                QPushButton {
                    background-color: #1f2b4d;
                    color: #ffffff;
                    border-radius: 6px;
                    padding: 6px 10px;
                    font-size: 11px;
                    text-align: left;
                }
                QPushButton:hover {
                    background-color: #2a3a5e;
                }
            """)
            # Вставляем рифму в конец текущей строки
            rhyme_btn.clicked.connect(lambda checked, r=rhyme, l=last_line: self._insert_rhyme(r, l))
            self.rhymes_content_layout.addWidget(rhyme_btn)

    def _insert_rhyme(self, rhyme, last_line):
        """Вставить рифму в конец последней строки активной секции."""
        if not hasattr(self, '_parent_editor') or not self._parent_editor:
            return
        editor = self._parent_editor
        if not editor.section_widgets:
            return

        # Находим последнюю секцию с текстом
        last_sec_key = None
        for sec_key in editor.section_widgets:
            sw = editor.section_widgets[sec_key]
            if sw.get_text().strip():
                last_sec_key = sec_key

        if not last_sec_key:
            return

        sw = editor.section_widgets[last_sec_key]
        current_text = sw.get_text()
        lines = current_text.split('\n')

        # Находим последнюю строку и добавляем рифму
        if lines:
            lines.append(rhyme)
            sw.set_text('\n'.join(lines))
            if editor.template_context and last_sec_key in editor.template_context['sections']:
                editor.template_context['sections'][last_sec_key]['text'] = sw.get_text()
            editor._on_section_changed(last_sec_key)

    def _show_random_phrases(self):
        """Показать случайные фразы из библиотеки."""
        self._clear_layout(self.phrases_content_layout)

        import random
        all_phrases = []
        for cat_phrases in phrases_engine.PHRASES.values():
            all_phrases.extend(cat_phrases)

        if not all_phrases:
            lbl = QLabel('Нет фраз')
            lbl.setObjectName('subheading_label')
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.phrases_content_layout.addWidget(lbl)
            return

        selected = random.sample(all_phrases, min(3, len(all_phrases)))

        for phrase in selected:
            phrase_frame = QFrame()
            phrase_frame.setStyleSheet("""
                background-color: #1f2b4d;
                border-radius: 6px;
                padding: 6px;
            """)
            phrase_layout = QHBoxLayout(phrase_frame)
            phrase_layout.setContentsMargins(6, 4, 6, 4)
            phrase_layout.setSpacing(6)

            phrase_lbl = QLabel(phrase)
            phrase_lbl.setFont(QFont('Segoe UI', 9))
            phrase_lbl.setStyleSheet('color: #b8b8d4; font-style: italic;')
            phrase_lbl.setWordWrap(True)
            phrase_lbl.setAlignment(Qt.AlignmentFlag.AlignTop | Qt.AlignmentFlag.AlignLeft)
            phrase_layout.addWidget(phrase_lbl, 1)

            insert_btn = QPushButton('➕')
            insert_btn.setFixedSize(24, 24)
            insert_btn.setCursor(Qt.CursorShape.PointingHandCursor)
            insert_btn.setStyleSheet("""
                QPushButton {
                    background-color: #2a3a5e;
                    color: #4CAF50;
                    border-radius: 4px;
                }
                QPushButton:hover {
                    background-color: #3a4a6e;
                }
            """)
            insert_btn.setToolTip('Вставить в текст')
            insert_btn.clicked.connect(lambda checked, p=phrase: self._insert_phrase(p))
            phrase_layout.addWidget(insert_btn)

            self.phrases_content_layout.addWidget(phrase_frame)

    def _insert_phrase(self, phrase):
        """Вставить фразу в конец текста активной секции."""
        if not hasattr(self, '_parent_editor') or not self._parent_editor:
            return
        editor = self._parent_editor
        if not editor.section_widgets:
            return

        # Находим последнюю секцию с текстом
        last_sec_key = None
        for sec_key in editor.section_widgets:
            sw = editor.section_widgets[sec_key]
            if sw.get_text().strip():
                last_sec_key = sec_key

        if not last_sec_key:
            return

        sw = editor.section_widgets[last_sec_key]
        current_text = sw.get_text()

        if current_text.strip():
            if phrase not in current_text:
                sw.set_text(current_text + '\n' + phrase)
                if editor.template_context and last_sec_key in editor.template_context['sections']:
                    editor.template_context['sections'][last_sec_key]['text'] = sw.get_text()
                editor._on_section_changed(last_sec_key)

    def _clear_layout(self, layout):
        """Очистить виджеты из layout."""
        while layout.count():
            item = layout.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.deleteLater()
            else:
                sub = item.layout()
                if sub:
                    sub.deleteLater()

    def _show_recommendations(self, recs, words, analysis):
        """Показать рекомендации."""
        self._clear_recommendations()

        if not recs:
            no_recs = QLabel('✅ Текст отличный! Рекомендаций нет.')
            no_recs.setStyleSheet('color: #4CAF50; font-style: italic; padding: 10px;')
            no_recs.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.recs_layout.addWidget(no_recs)
            return

        for rec in recs:
            rec_frame = QFrame()
            rec_frame.setStyleSheet('background-color: #1f2b4d; border-radius: 6px; padding: 8px;')
            rec_layout = QVBoxLayout(rec_frame)

            rec_lbl = QLabel(rec)
            rec_lbl.setObjectName('subheading_label')
            rec_lbl.setWordWrap(True)
            rec_layout.addWidget(rec_lbl)
            self.recs_layout.addWidget(rec_frame)

    def _clear_recommendations(self):
        """Очистить рекомендации."""
        while self.recs_layout.count():
            item = self.recs_layout.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.deleteLater()
            else:
                sub = item.layout()
                if sub:
                    sub.deleteLater()



class EditorPage(QWidget):
    def __init__(self, page_key, parent=None):
        super().__init__(parent)
        self.page_key = page_key
        self.current_song = None
        self.selected_template_id = None
        self.template_context = None
        self.section_widgets = {}
        self.autosave_timer = None
        self._init_ui()
        self._setup_autosave()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setSpacing(10)
        layout.setContentsMargins(15, 15, 15, 15)
        title = QLabel('Редактор песен')
        title.setObjectName('heading_label')
        layout.addWidget(title)
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.Shape.NoFrame)
        scroll_widget = QWidget()
        self.inner_layout = QVBoxLayout(scroll_widget)
        self.scroll.setWidget(scroll_widget)
        layout.addWidget(self.scroll)
        self._create_empty_state()

    def _create_empty_state(self):
        while self.inner_layout.count():
            item = self.inner_layout.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.deleteLater()
            else:
                sub_layout = item.layout()
                if sub_layout is not None:
                    sub_layout.deleteLater()
        placeholder = QLabel('Выберите шаблон или откройте сохраненную песню')
        placeholder.setObjectName('subheading_label')
        placeholder.setAlignment(Qt.AlignmentFlag.AlignCenter)
        placeholder.setMinimumHeight(120)
        self.inner_layout.addWidget(placeholder)
        self.inner_layout.addStretch()

    def _setup_autosave(self):
        self.autosave_timer = QTimer(self)
        self.autosave_timer.timeout.connect(self._autosave)
        self.autosave_timer.start(30000)

    def _autosave(self):
        if not self.current_song or not self.template_context:
            return
        try:
            for sec_key, sec_data in self.template_context['sections'].items():
                if sec_key in self.current_song['sections']:
                    self.current_song['sections'][sec_key]['text'] = sec_data.get('text', '')
            editor.save_song(self.current_song)
        except Exception:
            pass

    def set_template(self, style_id):
        self.current_song = None
        self.selected_template_id = style_id
        template = structure.get_template(style_id)
        if not template:
            QMessageBox.warning(self, 'Ошибка', 'Шаблон не найден')
            return
        self._build_template_selection(template)

    def load_song(self, song):
        self.current_song = song
        self.selected_template_id = song.get('style_id', 'pop')
        self.template_context = structure.create_template_context(self.selected_template_id)
        saved = song.get('sections', {})
        for key, data in self.template_context['sections'].items():
            if key in saved:
                data['text'] = saved[key].get('text', '')
                data['tips'] = saved[key].get('tips', [])
        title = song.get('title', 'Без названия')
        self._build_editor(title)

    def _build_template_selection(self, template):
        while self.inner_layout.count():
            item = self.inner_layout.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.deleteLater()
            else:
                sub_layout = item.layout()
                if sub_layout is not None:
                    sub_layout.deleteLater()

        card = QFrame()
        card.setObjectName('card_frame')
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(20, 20, 20, 12)
        card_layout.setSpacing(8)

        name_lbl = QLabel(template['name'])
        name_lbl.setFont(QFont('Segoe UI', 14, QFont.Weight.Bold))
        name_lbl.setStyleSheet('color: #ffffff;')
        card_layout.addWidget(name_lbl)

        desc_lbl = QLabel(template['description'])
        desc_lbl.setObjectName('subheading_label')
        desc_lbl.setWordWrap(True)
        card_layout.addWidget(desc_lbl)

        self.inner_layout.addWidget(card)

        title_layout = QHBoxLayout()
        title_label = QLabel('Название песни:')
        title_label.setFont(QFont('Segoe UI', 11, QFont.Weight.Bold))
        title_layout.addWidget(title_label)

        self.title_input = QLineEdit()
        self.title_input.setPlaceholderText('Введите название...')
        self.title_input.setMinimumHeight(40)
        self.title_input.returnPressed.connect(self._on_create_song)
        title_layout.addWidget(self.title_input)
        self.inner_layout.addLayout(title_layout)

        btn = QPushButton('Создать песню')
        btn.setMinimumHeight(40)
        btn.setCursor(Qt.CursorShape.PointingHandCursor)
        btn.clicked.connect(self._on_create_song)
        self.inner_layout.addWidget(btn)

        self.inner_layout.addStretch()
        self.title_input.setFocus()

    def _on_create_song(self):
        title = self.title_input.text().strip()
        if not title:
            QMessageBox.warning(self, 'Ошибка', 'Введите название песни')
            return
        self.template_context = structure.create_template_context(self.selected_template_id)
        self.current_song = editor.create_song(title, self.selected_template_id, self.template_context)
        QMessageBox.information(self, 'Успех', f'Песня "{title}" создана!')
        self._build_editor(title)

    def _build_editor(self, title):
        while self.inner_layout.count():
            item = self.inner_layout.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.deleteLater()
            else:
                sub_layout = item.layout()
                if sub_layout is not None:
                    sub_layout.deleteLater()
        self.section_widgets = {}

        header = QFrame()
        header.setObjectName('card_frame')
        h_layout = QHBoxLayout(header)
        h_layout.setContentsMargins(15, 10, 15, 10)

        t_lbl = QLabel(title)
        t_lbl.setFont(QFont('Segoe UI', 15, QFont.Weight.Bold))
        t_lbl.setStyleSheet('color: #e94560;')
        h_layout.addWidget(t_lbl)

        tmpl = structure.get_template(self.selected_template_id)
        s_lbl = QLabel(tmpl['name'])
        s_lbl.setObjectName('subheading_label')
        h_layout.addWidget(s_lbl)
        h_layout.addStretch()
        self.inner_layout.addWidget(header)

        p_layout = QHBoxLayout()
        self.progress_bar = QProgressBar()
        self.progress_bar.setFixedHeight(14)
        p_layout.addWidget(self.progress_bar, 1)
        self.progress_lbl = QLabel('0 / 0')
        p_layout.addWidget(self.progress_lbl)
        self.inner_layout.addLayout(p_layout)

        # Основной layout
        main_layout = QHBoxLayout()
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(10)

        # Центральная область с секциями
        self.section_tabs = QTabWidget()
        self.section_tabs.setStyleSheet("""
            QTabWidget::pane {
                border: 1px solid #2a2a4a;
                border-radius: 10px;
                background-color: #0f0f23;
            }
            QTabBar::tab {
                background-color: #16213e;
                color: #b8b8d4;
                padding: 10px 20px;
                margin-right: 2px;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
            }
            QTabBar::tab:selected {
                background-color: #1f2b4d;
                color: #ffffff;
                font-weight: bold;
            }
            QTabBar::tab:hover {
                background-color: #1f2b4d;
            }
        """)
        main_layout.addWidget(self.section_tabs, 1)

        # Правая панель AI-рекомендаций
        self.ai_panel = AIRecommendationsPanel(self)
        self.ai_panel._parent_editor = self
        main_layout.addWidget(self.ai_panel)

        self.inner_layout.addLayout(main_layout)

        # Навигация по секциям (кнопки)
        nav_layout = QHBoxLayout()
        self.prev_sec_btn = QPushButton('◀ Назад')
        self.prev_sec_btn.setMinimumHeight(30)
        self.prev_sec_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.prev_sec_btn.clicked.connect(self._go_to_prev_section)
        self.prev_sec_btn.setEnabled(False)
        nav_layout.addWidget(self.prev_sec_btn)

        self.section_tabs_combo = QComboBox()
        self.section_tabs_combo.setMinimumHeight(30)
        self.section_tabs_combo.currentIndexChanged.connect(self._on_tab_changed)
        nav_layout.addWidget(self.section_tabs_combo, 1)

        self.next_sec_btn = QPushButton('Далее ▶')
        self.next_sec_btn.setMinimumHeight(30)
        self.next_sec_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.next_sec_btn.clicked.connect(self._go_to_next_section)
        nav_layout.addWidget(self.next_sec_btn)
        self.inner_layout.addLayout(nav_layout)

        self._build_buttons()
        self._update_progress()

        # Создаём вкладки для каждой секции
        self._create_section_tabs()

        # Обновляем AI-рекомендации
        if self.template_context and hasattr(self, 'ai_panel'):
            self.ai_panel.analyze_from_context(self.template_context)

        # Timer для автоматического обновления AI-рекомендаций
        self._ai_timer = QTimer(self)
        self._ai_timer.timeout.connect(self._update_ai_panel)
        self._ai_timer.start(2000)  # каждые 2 секунды

    def _update_ai_panel(self):
        """Автоматическое обновление AI-панели."""
        if self.template_context and hasattr(self, 'ai_panel'):
            self.ai_panel.analyze_from_context(self.template_context)

    def _on_section_changed(self, sec_key):
        # Временно отключен
        pass

    def _show_rhyme_hints(self, last_line):
        words = last_line.lower().split()
        if not words:
            return
        last_word = words[-1].strip('.,!')
        if not last_word or len(last_word) < 3:
            return
        suggested = rhymes.get_rhymes(last_word, max_results=3)
        if suggested:
            print(f'Rhymes: {", ".join(suggested)}')

    def _update_progress(self):
        if not self.template_context:
            return
        sections = self.template_context.get('sections', {})
        total = self.template_context.get('total_sections', 1)
        filled = sum(1 for s in sections.values() if s.get('text', '').strip())
        pct = int((filled / total) * 100) if total > 0 else 0
        self.progress_bar.setValue(pct)
        self.progress_lbl.setText(f'{filled} / {total}')

    def _create_section_tabs(self):
        """Создаём вкладки для каждой секции."""
        if not self.template_context:
            return
        
        self.active_tab_index = 0
        tab_index = 0
        
        for sec_key, sec_data in self.template_context['sections'].items():
            tab_widget = QWidget()
            tab_layout = QVBoxLayout(tab_widget)
            tab_layout.setContentsMargins(10, 10, 10, 10)
            tab_layout.setSpacing(8)

            sw = SectionWidget(sec_key, sec_data, self)
            sw.sec_key = sec_key
            
            # Блокируем сигнал на время установки
            sw.text_area.blockSignals(True)
            sw.set_text(sec_data.get('text', ''))
            
            tab_layout.addWidget(sw, 1)
            self.section_widgets[sec_key] = sw

            icon = sw._get_icon(sec_data.get('type', ''))
            label = sec_data.get('label', sec_key)
            self.section_tabs.addTab(tab_widget, f'{icon} {label}')
            self.section_tabs.tabBar().setTabData(tab_index, sec_key)
            tab_index += 1
        
        self._update_navigation()

    def _update_navigation(self):
        """Обновить состояние кнопок навигации и комбобокса."""
        section_keys = list(self.template_context['sections'].keys())
        total = len(section_keys)

        # Обновляем комбобокс
        self.section_tabs_combo.clear()
        for key in section_keys:
            sw = self.section_widgets.get(key)
            if sw:
                icon = sw._get_icon(self.template_context['sections'][key].get('type', ''))
                label = self.template_context['sections'][key].get('label', key)
                text = sw.get_text().strip()
                status = '✓' if text else '○'
                self.section_tabs_combo.addItem(f'{status} {icon} {label}', key)

        # Активируем текущую вкладку в комбобоксе
        current_sec_key = self.section_tabs.tabBar().tabData(self.active_tab_index)
        combo_index = self.section_tabs_combo.findData(current_sec_key)
        if combo_index >= 0:
            self.section_tabs_combo.setCurrentIndex(combo_index)

        # Обновляем кнопки
        self.prev_sec_btn.setEnabled(self.active_tab_index > 0)
        self.next_sec_btn.setEnabled(self.active_tab_index < total - 1)

    def _on_tab_changed_by_index(self, index):
        """Обработка смены вкладки."""
        self.active_tab_index = index
        self._update_navigation()

    def _on_tab_changed(self, index):
        """Обработка выбора в комбобоксе."""
        if index >= 0:
            sec_key = self.section_tabs_combo.itemData(index)
            if sec_key and sec_key in self.section_widgets:
                # Находим индекс вкладки
                for i in range(self.section_tabs.count()):
                    if self.section_tabs.tabBar().tabData(i) == sec_key:
                        self.section_tabs.setCurrentIndex(i)
                        self.active_tab_index = i
                        self._update_navigation()
                        break

    def _go_to_prev_section(self):
        """Перейти к предыдущей секции."""
        if self.active_tab_index > 0:
            self.active_tab_index -= 1
            self.section_tabs.setCurrentIndex(self.active_tab_index)
            self._update_navigation()

    def _go_to_next_section(self):
        """Перейти к следующей секции."""
        total = self.section_tabs.count()
        if self.active_tab_index < total - 1:
            self.active_tab_index += 1
            self.section_tabs.setCurrentIndex(self.active_tab_index)
            self._update_navigation()

    def _build_buttons(self):
        btn_frame = QFrame()
        btn_frame.setObjectName('card_frame')
        b_layout = QHBoxLayout(btn_frame)
        b_layout.setContentsMargins(15, 10, 15, 10)
        b_layout.setSpacing(8)

        save_btn = QPushButton('Сохранить')
        save_btn.setMinimumHeight(35)
        save_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        save_btn.clicked.connect(self._on_save)
        b_layout.addWidget(save_btn)

        analyze_btn = QPushButton('Анализ')
        analyze_btn.setMinimumHeight(35)
        analyze_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        analyze_btn.clicked.connect(self._on_analyze)
        b_layout.addWidget(analyze_btn)

        self.inner_layout.addWidget(btn_frame)

    def _on_analyze(self):
        if not self.current_song:
            QMessageBox.warning(self, 'Ошибка', 'Сначала создайте и сохраните песню')
            return
        dialog = RhymeAnalysisDialog(self.current_song, self)
        dialog.exec()

    def _on_save(self):
        if not self.current_song:
            title = 'Без названия'
            if not self.template_context:
                QMessageBox.warning(self, 'Ошибка', 'Сначала выберите шаблон')
                return
            self.current_song = editor.create_song(title, self.selected_template_id, self.template_context)
            QMessageBox.information(self, 'Успех', 'Песня создана!')
        else:
            for sec_key, sec_data in self.template_context['sections'].items():
                if sec_key in self.current_song['sections']:
                    self.current_song['sections'][sec_key]['text'] = sec_data.get('text', '')
                    self.current_song['sections'][sec_key]['tips'] = sec_data.get('tips', [])
            editor.save_song(self.current_song)
            QMessageBox.information(self, 'Успех', 'Песня сохранена!')

    def _build_stats(self):
        pass




class RhymeAnalysisDialog(QDialog):
    def __init__(self, song_data, parent=None):
        super().__init__(parent)
        self.song_data = song_data
        self.setWindowTitle('Анализ рифмовки')
        self.setMinimumSize(800, 600)
        self._init_ui()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(15, 15, 15, 15)

        title = QLabel('Анализ рифмовки')
        title.setObjectName('heading_label')
        title.setFont(QFont('Segoe UI', 16, QFont.Weight.Bold))
        layout.addWidget(title)

        all_lines = []
        sections = self.song_data.get('sections', {})
        for sec_key, sec_data in sections.items():
            text = sec_data.get('text', '')
            if text.strip():
                lines = [l.strip() for l in text.split(chr(10)) if l.strip()]
                all_lines.extend(lines)

        if not all_lines:
            lbl = QLabel('Нет текста для анализа.')
            lbl.setObjectName('subheading_label')
            layout.addWidget(lbl)
            return

        analysis = rhyme_analyzer.analyze_rhyme_scheme(all_lines)
        stats = analysis['stats']

        stats_frame = QFrame()
        stats_frame.setObjectName('card_frame')
        stats_layout = QHBoxLayout(stats_frame)
        stats_layout.setContentsMargins(15, 12, 15, 12)

        pct_card = QFrame()
        pct_card.setStyleSheet('background-color: #16213e; border-radius: 12px; padding: 15px;')
        pct_layout = QVBoxLayout(pct_card)
        pct_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        pct_label = QLabel(str(stats['percent']) + '%')
        pct_label.setFont(QFont('Segoe UI', 28, QFont.Weight.Bold))
        pct_label.setStyleSheet('color: #e94560;')
        pct_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        pct_layout.addWidget(pct_label)

        qual_label = QLabel('Рифмовано: ' + str(stats['rhymed']) + '/' + str(stats['total']))
        qual_label.setObjectName('subheading_label')
        qual_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        pct_layout.addWidget(qual_label)
        stats_layout.addWidget(pct_card, 1)
        layout.addWidget(stats_frame)

        scheme_frame = QFrame()
        scheme_frame.setStyleSheet('background-color: #16213e; border-radius: 12px; padding: 15px;')
        scheme_layout = QVBoxLayout(scheme_frame)
        scheme_title = QLabel('Схема рифмовки')
        scheme_title.setFont(QFont('Segoe UI', 13, QFont.Weight.Bold))
        scheme_layout.addWidget(scheme_title)
        scheme_text = ', '.join(analysis['scheme'])
        scheme_lbl = QLabel(scheme_text)
        scheme_lbl.setFont(QFont('Consolas', 11))
        scheme_lbl.setStyleSheet('color: #00bcd4; background-color: #1f2b4d; padding: 10px; border-radius: 6px;')
        scheme_layout.addWidget(scheme_lbl)
        layout.addWidget(scheme_frame)

        if analysis['rhymed_pairs']:
            pairs_frame = QFrame()
            pairs_frame.setStyleSheet('background-color: #16213e; border-radius: 12px; padding: 15px;')
            pairs_layout = QVBoxLayout(pairs_frame)
            pairs_title = QLabel('Рифмующиеся пары')
            pairs_title.setFont(QFont('Segoe UI', 13, QFont.Weight.Bold))
            pairs_layout.addWidget(pairs_title)
            for pair in analysis['rhymed_pairs']:
                pair_info = QLabel(pair['letter'] + ': ' + ', '.join(pair['words']))
                pair_info.setFont(QFont('Segoe UI', 9, QFont.Weight.Bold))
                pair_info.setStyleSheet('color: #4CAF50;')
                pairs_layout.addWidget(pair_info)
                for line in pair['lines']:
                    line_lbl = QLabel('  - ' + line)
                    line_lbl.setStyleSheet('color: #b8b8d4; font-style: italic;')
                    pairs_layout.addWidget(line_lbl)
            layout.addWidget(pairs_frame)

        recs = rhyme_analyzer.get_recommendations(analysis, rhyme_analyzer.analyze_rhythm(all_lines), rhyme_analyzer.analyze_words(all_lines))
        if recs:
            rec_frame = QFrame()
            rec_frame.setStyleSheet('background-color: #16213e; border-radius: 12px; padding: 15px;')
            rec_layout = QVBoxLayout(rec_frame)
            rec_title = QLabel('Рекомендации')
            rec_title.setFont(QFont('Segoe UI', 13, QFont.Weight.Bold))
            rec_title.setStyleSheet('color: #fbbf24;')
            rec_layout.addWidget(rec_title)
            for rec in recs:
                rec_lbl = QLabel(rec)
                rec_lbl.setObjectName('subheading_label')
                rec_lbl.setWordWrap(True)
                rec_layout.addWidget(rec_lbl)
            layout.addWidget(rec_frame)

        close_btn = QPushButton('Закрыть')
        close_btn.setMinimumHeight(40)
        close_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        close_btn.clicked.connect(self.close)
        layout.addWidget(close_btn)


class ПредпросмотрDialog(QDialog):
    def __init__(self, song_data, parent=None):
        super().__init__(parent)
        self.song_data = song_data
        self.setWindowTitle('Предпросмотр')
        self.setMinimumSize(700, 600)
        self._init_ui()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        title = QLabel(self.song_data.get('title', 'Без названия'))
        title.setObjectName('heading_label')
        title.setFont(QFont('Segoe UI', 16, QFont.Weight.Bold))
        layout.addWidget(title)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        content = QWidget()
        text_layout = QVBoxLayout(content)
        sections = self.song_data.get('sections', {})
        for sec_key, sec_data in sections.items():
            text = sec_data.get('text', '').strip()
            if text:
                sec_frame = QFrame()
                sec_frame.setStyleSheet('background-color: #16213e; border-radius: 10px; padding: 12px;')
                sec_layout = QVBoxLayout(sec_frame)
                sec_label = sec_data.get('label', sec_key)
                sec_title = QLabel(sec_label)
                sec_title.setFont(QFont('Segoe UI', 12, QFont.Weight.Bold))
                sec_title.setStyleSheet('color: #00bcd4;')
                sec_layout.addWidget(sec_title)
                text_lbl = QLabel(text)
                text_lbl.setFont(QFont('Segoe UI', 10))
                text_lbl.setStyleSheet('color: #ffffff;')
                text_lbl.setWordWrap(True)
                sec_layout.addWidget(text_lbl)
                text_layout.addWidget(sec_frame)
        text_layout.addStretch()
        scroll.setWidget(content)
        layout.addWidget(scroll, 1)

        close_btn = QPushButton('Закрыть')
        close_btn.setMinimumHeight(40)
        close_btn.clicked.connect(self.close)
        layout.addWidget(close_btn)

    def _build_stats(self):
        pass
